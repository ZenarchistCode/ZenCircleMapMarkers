WrapSpacerWidgetClass ZenCircleCategory {
 visible 1
 position 0 0
 size 1 1
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 Padding 0
 Margin 0
 "Size To Content H" 1
 "Size To Content V" 1
 content_halign center
 {
  WrapSpacerWidgetClass ZenCircleCategoryHeader {
   visible 1
   ignorepointer 1
   size 1 1
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   Padding 0
   Margin 0
   "Size To Content H" 1
   "Size To Content V" 1
   content_halign center
   content_valign center
   {
    ButtonWidgetClass ZenCircleCategoryHeaderButton {
     visible 1
     ignorepointer 0
     color 0.8627 0.8627 0.8627 0.549
     size 285 30
     halign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 1
     vexactsize 1
     priority 1
     style Default
     {
      TextWidgetClass ZenCircleCategoryHeaderLabel {
       visible 1
       ignorepointer 1
       color 0.8627 0.8627 0.8627 1
       size 250 32
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       style Normal
       text "CIRCLE MARKERS"
       font "gui/fonts/sdf_MetronBook24"
       "exact text" 1
       "exact text size" 14
       "text valign" center
      }
      ImageWidgetClass ZenCircleCategoryHeaderIcon {
       visible 1
       ignorepointer 1
       color 0.8627 0.8627 0.8627 1
       size 32 32
       halign right_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       mode blend
       "src alpha" 1
       "no wrap" 1
       stretch 1
       "flip v" 1
      }
     }
    }
    PanelWidgetClass ZenCircleCategorySeparator {
     visible 1
     ignorepointer 1
     color 0.8627 0.8627 0.8627 0.549
     size 285 2
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     priority 1
     style DayZDefaultPanel
    }
   }
  }
  WrapSpacerWidgetClass ZenCircleCategoryContent {
   visible 1
   ignorepointer 1
   size 285 1
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 0
   Padding 0
   Margin 0
